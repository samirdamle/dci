[
  {
    "name": "@samirdamle/dci-protocol",
    "path": "packages/protocol/dist/index.js",
    "import": "*",
    "limit": "2 KB",
    "gzip": true
  },
  {
    "name": "@samirdamle/dci-core (headless: gestures, selection, controller, transport)",
    "path": "packages/core/dist/index.js",
    "import": "{ createInteractions, createChatController, createSSETransport, createActionRegistry }",
    "ignore": ["@floating-ui/dom"],
    "limit": "15 KB",
    "gzip": true
  },
  {
    "name": "@samirdamle/dci-core (full: createDci with overlay and chat UI)",
    "path": "packages/core/dist/index.js",
    "import": "{ createDci }",
    "limit": "40 KB",
    "gzip": true
  },
  {
    "name": "@samirdamle/dci-react (on top of core)",
    "path": "packages/react/dist/index.js",
    "import": "*",
    "ignore": ["@samirdamle/dci-core", "react"],
    "limit": "2 KB",
    "gzip": true
  },
  {
    "name": "@samirdamle/dci-server",
    "path": "packages/server/dist/index.js",
    "import": "*",
    "ignore": ["@samirdamle/dci-protocol"],
    "limit": "4 KB",
    "gzip": true
  }
]
