{
  "name": "@dci/protocol",
  "version": "0.0.0",
  "description": "DCI wire-protocol types and SSE encoder/decoder.",
  "keywords": [
    "ai",
    "llm",
    "protocol",
    "sse",
    "server-sent-events",
    "types"
  ],
  "homepage": "https://github.com/samirdamle/dci/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/samirdamle/dci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samirdamle/dci.git",
    "directory": "packages/protocol"
  },
  "license": "MIT",
  "author": "Samir Damle",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@dci/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
