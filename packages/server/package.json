{
  "name": "@samirdamle/dci-server",
  "version": "1.1.0",
  "description": "Node helpers for the DCI endpoint protocol.",
  "keywords": [
    "ai",
    "llm",
    "sse",
    "server-sent-events",
    "streaming",
    "agent",
    "claude",
    "edge"
  ],
  "homepage": "https://github.com/samirdamle/dci/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/samirdamle/dci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samirdamle/dci.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "author": "Samir Damle",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@dci/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "@dci/source": "./src/node.ts",
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@samirdamle/dci-protocol": "workspace:*"
  },
  "devDependencies": {
    "@samirdamle/dci-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
