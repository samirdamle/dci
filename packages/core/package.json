{
  "name": "@samirdamle/dci-core",
  "version": "1.0.0",
  "description": "Framework-agnostic DCI selection engine, overlay, chat UI and transport.",
  "keywords": [
    "ai",
    "llm",
    "context",
    "selection",
    "chat",
    "agent",
    "alt-click",
    "dom",
    "headless"
  ],
  "homepage": "https://github.com/samirdamle/dci/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/samirdamle/dci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samirdamle/dci.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Samir Damle",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@dci/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@samirdamle/dci-protocol": "workspace:*",
    "@floating-ui/dom": "^1.8.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
