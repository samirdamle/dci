{
  "name": "@samirdamle/dci-react",
  "version": "0.0.0",
  "description": "React bindings for DCI.",
  "keywords": [
    "ai",
    "llm",
    "context",
    "selection",
    "chat",
    "react",
    "hooks"
  ],
  "homepage": "https://github.com/samirdamle/dci/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/samirdamle/dci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samirdamle/dci.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Samir Damle",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@dci/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@samirdamle/dci-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
